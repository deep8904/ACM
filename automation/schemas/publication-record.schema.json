{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^publication_[a-f0-9]{24}$"
    },
    "topicId": {
      "type": "string"
    },
    "draftId": {
      "type": "string",
      "pattern": "^draft_[a-f0-9]{24}$"
    },
    "draftVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reviewId": {
      "type": "string",
      "pattern": "^review_[a-f0-9]{24}$"
    },
    "reviewVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "researchPacketId": {
      "type": "string",
      "pattern": "^packet_[a-f0-9]{24}$"
    },
    "researchPacketVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "finalApprovedEventId": {
      "type": "string",
      "pattern": "^articleevent_[a-f0-9]{24}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "committed",
        "deploying",
        "published",
        "deployment_failed",
        "verification_required",
        "cancelled",
        "superseded"
      ]
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "articlePath": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commitUrl": {
      "type": "string",
      "format": "uri"
    },
    "deploymentProvider": {
      "type": "string",
      "enum": [
        "mock",
        "vercel_git",
        "manual"
      ]
    },
    "deploymentId": {
      "type": "string"
    },
    "deploymentUrl": {
      "type": "string",
      "format": "uri"
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "scheduledFor": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "sourceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvedSnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publishedSnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fixture",
            "github"
          ]
        },
        "parentSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "mode",
        "parentSha"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "topicId",
    "draftId",
    "draftVersion",
    "reviewId",
    "reviewVersion",
    "researchPacketId",
    "researchPacketVersion",
    "finalApprovedEventId",
    "status",
    "title",
    "slug",
    "articlePath",
    "repository",
    "branch",
    "commitSha",
    "deploymentProvider",
    "canonicalUrl",
    "publishedAt",
    "sourceCount",
    "contentHash",
    "approvedSnapshotHash",
    "publishedSnapshotHash",
    "createdAt",
    "updatedAt",
    "warnings",
    "provenance",
    "version"
  ],
  "additionalProperties": false
}
