{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "article-draft",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^draft_[a-f0-9]{24}$"
    },
    "topicId": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "researchPacketId": {
      "type": "string"
    },
    "researchPacketVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "approvedEventId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "awaiting_manual_writing",
        "imported",
        "validated",
        "blocked",
        "superseded",
        "cancelled"
      ]
    },
    "articleType": {
      "type": "string",
      "enum": [
        "breaking_news",
        "news_analysis",
        "technical_explainer",
        "release_guide",
        "source_based_review",
        "buying_analysis",
        "comparison",
        "industry_analysis",
        "opinion_analysis",
        "tutorial_candidate"
      ]
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "AI",
        "Software",
        "Development",
        "Hardware",
        "Design",
        "Gaming",
        "Game Development",
        "Creator Technology",
        "Product Analysis",
        "Industry"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string",
      "const": "Deep"
    },
    "heroImage": {
      "type": "null"
    },
    "heroAlt": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "null"
    },
    "publishedAt": {
      "type": "null"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "draft": {
      "type": "boolean",
      "const": true
    },
    "mdx": {
      "type": "string"
    },
    "plainText": {
      "type": "string"
    },
    "wordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "readingTimeMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "headingOutline": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "level",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claimReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^draftclaim_[a-f0-9]{24}$"
          },
          "draftId": {
            "type": "string",
            "pattern": "^draft_[a-f0-9]{24}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "claimType": {
            "type": "string",
            "enum": [
              "fact",
              "specification",
              "timeline",
              "quote",
              "interpretation",
              "prediction",
              "opinion",
              "community_observation"
            ]
          },
          "researchClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^claim_[a-f0-9]{24}$"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^source_[a-f0-9]{24}$"
            }
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "supportStatus": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "analysis",
              "opinion",
              "prediction"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "id",
          "draftId",
          "statement",
          "claimType",
          "researchClaimIds",
          "sourceIds",
          "section",
          "supportStatus",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "researchContentHashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "writingMode": {
      "type": "string",
      "enum": [
        "manual_claude_code",
        "deterministic_placeholder",
        "future_api"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "supersedesVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provenance": {
      "type": "object",
      "properties": {
        "taskHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "importHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "importedBy": {
          "type": "string",
          "const": "manual"
        },
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        }
      },
      "required": [
        "taskHash",
        "importHash",
        "importedAt",
        "importedBy",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "topicId",
    "candidateId",
    "researchPacketId",
    "researchPacketVersion",
    "approvedEventId",
    "version",
    "status",
    "articleType",
    "title",
    "slug",
    "description",
    "category",
    "tags",
    "author",
    "heroImage",
    "heroAlt",
    "canonicalUrl",
    "publishedAt",
    "updatedAt",
    "draft",
    "mdx",
    "plainText",
    "wordCount",
    "readingTimeMinutes",
    "headingOutline",
    "sourceIds",
    "claimReferences",
    "researchContentHashes",
    "writingMode",
    "createdAt",
    "provenance",
    "warnings"
  ],
  "additionalProperties": false
}
