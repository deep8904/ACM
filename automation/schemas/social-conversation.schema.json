{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chatId": {
      "type": "string",
      "pattern": "^-?\\d+$"
    },
    "userId": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "publicationId": {
      "type": "string",
      "pattern": "^publication_[a-f0-9]{24}$"
    },
    "packageVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "platformItemId": {
      "type": "string",
      "pattern": "^socialitem_[a-f0-9]{24}$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "x",
        "instagram",
        "medium"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "awaiting_social_change_request",
        "awaiting_social_schedule_time",
        "awaiting_social_rejection_reason",
        "awaiting_social_approval_note",
        "awaiting_social_post_url"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "chatId",
    "userId",
    "publicationId",
    "packageVersion",
    "platformItemId",
    "platform",
    "state",
    "createdAt",
    "expiresAt"
  ],
  "additionalProperties": false
}
