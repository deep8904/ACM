{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "publicationId": {
      "type": "string",
      "pattern": "^publication_[a-f0-9]{24}$"
    },
    "sourcePackageVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "string",
      "enum": [
        "linkedin_only",
        "x_post_only",
        "x_thread_only",
        "instagram_carousel_only",
        "instagram_caption_only",
        "medium_only",
        "timing_only",
        "visual_brief_only",
        "full_package"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "protectedClaimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pubclaim_[a-f0-9]{16}$"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "taskHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "publicationId",
    "sourcePackageVersion",
    "scope",
    "instruction",
    "protectedClaimIds",
    "createdAt",
    "taskHash"
  ],
  "additionalProperties": false
}
