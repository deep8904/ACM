{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "finalApprovedEventId": {
      "type": "string",
      "pattern": "^articleevent_[a-f0-9]{24}$"
    },
    "consumerId": {
      "type": "string"
    },
    "publicationId": {
      "type": "string",
      "pattern": "^publication_[a-f0-9]{24}$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deploymentId": {
      "type": "string"
    },
    "verificationState": {
      "type": "string",
      "enum": [
        "verified",
        "best_effort"
      ]
    },
    "consumedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "finalApprovedEventId",
    "consumerId",
    "publicationId",
    "commitSha",
    "verificationState",
    "consumedAt",
    "snapshotHash"
  ],
  "additionalProperties": false
}
