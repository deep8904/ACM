{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryCluster",
  "type": "object",
  "required": [
    "id",
    "runId",
    "representativeTitle",
    "normalizedTitle",
    "summary",
    "sourceItemIds",
    "sourceIds",
    "primarySourceItemIds",
    "authorityCounts",
    "categories",
    "keywords",
    "entities",
    "firstSeenAt",
    "latestSignalAt",
    "sourceCount",
    "independentSourceCount",
    "discussionSignals",
    "clusterConfidence",
    "clusterReasons",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "runId": { "type": "string" },
    "representativeTitle": { "type": "string" },
    "representativeTitleReason": { "type": "string" },
    "normalizedTitle": { "type": "string" },
    "summary": { "type": "string" },
    "sourceItemIds": { "type": "array", "items": { "type": "string" } },
    "sourceIds": { "type": "array", "items": { "type": "string" } },
    "primarySourceItemIds": { "type": "array", "items": { "type": "string" } },
    "authorityCounts": {
      "type": "object",
      "required": ["primary", "independent", "community", "aggregator"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "categories": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "entities": { "type": "array", "items": { "type": "string" } },
    "productIdentifiers": { "type": "array", "items": { "type": "string" } },
    "eventKeywords": { "type": "array", "items": { "type": "string" } },
    "firstSeenAt": { "type": "string", "format": "date-time" },
    "latestSignalAt": { "type": "string", "format": "date-time" },
    "publishedAtEarliest": { "type": "string", "format": "date-time" },
    "publishedAtLatest": { "type": "string", "format": "date-time" },
    "sourceCount": { "type": "integer", "minimum": 1 },
    "independentSourceCount": { "type": "integer", "minimum": 0 },
    "discussionSignals": { "type": "array", "items": { "type": "object" } },
    "clusterConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "clusterReasons": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string" },
    "status": { "enum": ["active", "suppressed", "rejected", "expired"] }
  }
}
