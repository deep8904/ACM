{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "pattern": "^report_[a-f0-9]{24}$"
    },
    "reportContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "metricIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "publicationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^publication_[a-f0-9]{24}$"
            }
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sampleSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "moderate",
              "low",
              "insufficient"
            ]
          },
          "interpretation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "alternativeExplanations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "title",
          "metricIds",
          "publicationIds",
          "period",
          "sampleSize",
          "confidence",
          "interpretation",
          "alternativeExplanations",
          "recommendation"
        ],
        "additionalProperties": false
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "status": {
      "type": "string",
      "const": "advisory_only"
    }
  },
  "required": [
    "reportId",
    "reportContentHash",
    "taskHash",
    "observations",
    "unresolvedQuestions",
    "status"
  ],
  "additionalProperties": false
}
