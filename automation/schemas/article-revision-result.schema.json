{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "topicId": {
      "type": "string"
    },
    "sourceDraftId": {
      "type": "string",
      "pattern": "^draft_[a-f0-9]{24}$"
    },
    "sourceDraftVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "revisionScope": {
      "type": "string",
      "enum": [
        "title_only",
        "description_only",
        "introduction_only",
        "section_only",
        "citation_fix",
        "disclosure_fix",
        "tone_adjustment",
        "structure_adjustment",
        "full_revision"
      ]
    },
    "addressedIssueIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^issue_[a-f0-9]{24}$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 110
    },
    "alternateTitles": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 110
      }
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 180
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mdx": {
      "type": "string",
      "minLength": 1
    },
    "claimReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^draftclaim_[a-f0-9]{24}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "claimType": {
            "type": "string",
            "enum": [
              "fact",
              "specification",
              "timeline",
              "quote",
              "interpretation",
              "prediction",
              "opinion",
              "community_observation"
            ]
          },
          "researchClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^claim_[a-f0-9]{24}$"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^source_[a-f0-9]{24}$"
            }
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "supportStatus": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "analysis",
              "opinion",
              "prediction"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "id",
          "statement",
          "claimType",
          "researchClaimIds",
          "sourceIds",
          "section",
          "supportStatus",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "sourceIdsUsed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^source_[a-f0-9]{24}$"
      }
    },
    "changeSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "writerNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "unresolvedIssues": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^issue_[a-f0-9]{24}$"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "manual_claude_code"
        },
        "taskHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "mode",
        "taskHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "topicId",
    "sourceDraftId",
    "sourceDraftVersion",
    "revisionScope",
    "addressedIssueIds",
    "title",
    "alternateTitles",
    "description",
    "slug",
    "mdx",
    "claimReferences",
    "sourceIdsUsed",
    "changeSummary",
    "writerNotes",
    "unresolvedIssues",
    "provenance"
  ],
  "additionalProperties": false
}
