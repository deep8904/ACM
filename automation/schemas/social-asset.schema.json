{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^socialasset_[a-f0-9]{24}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^socialplan_[a-f0-9]{24}$"
    },
    "publicationId": {
      "type": "string",
      "pattern": "^publication_[a-f0-9]{24}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^socialpackage_[a-f0-9]{24}$"
    },
    "packageVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "x",
        "instagram",
        "medium"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "social_card",
        "carousel_slide",
        "medium_inline",
        "approved_hero"
      ]
    },
    "format": {
      "type": "string",
      "const": "png"
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "slideNumber": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "altText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "planId",
    "publicationId",
    "packageId",
    "packageVersion",
    "platform",
    "kind",
    "format",
    "width",
    "height",
    "path",
    "contentHash",
    "altText",
    "createdAt"
  ],
  "additionalProperties": false
}
