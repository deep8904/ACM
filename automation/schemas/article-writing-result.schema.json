{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "article-writing-result",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "topicId": {
      "type": "string",
      "minLength": 1
    },
    "researchPacketId": {
      "type": "string",
      "pattern": "^packet_[a-f0-9]{24}$"
    },
    "researchPacketVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "articleType": {
      "type": "string",
      "enum": [
        "breaking_news",
        "news_analysis",
        "technical_explainer",
        "release_guide",
        "source_based_review",
        "buying_analysis",
        "comparison",
        "industry_analysis",
        "opinion_analysis",
        "tutorial_candidate"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 110
        },
        "alternateTitles": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 110
          }
        },
        "seoTitle": {
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        },
        "socialHeadline": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "maxLength": 90,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 80,
          "maxLength": 180
        },
        "excerpt": {
          "type": "string",
          "minLength": 40,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "enum": [
            "AI",
            "Software",
            "Development",
            "Hardware",
            "Design",
            "Gaming",
            "Game Development",
            "Creator Technology",
            "Product Analysis",
            "Industry"
          ]
        },
        "tags": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "author": {
          "type": "string",
          "const": "Deep"
        },
        "heroImage": {
          "type": "null"
        },
        "heroAlt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "canonicalUrl": {
          "type": "null"
        },
        "publishedAt": {
          "type": "null"
        },
        "status": {
          "type": "string",
          "const": "draft"
        },
        "draft": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "title",
        "alternateTitles",
        "seoTitle",
        "socialHeadline",
        "slug",
        "description",
        "excerpt",
        "category",
        "tags",
        "author",
        "heroImage",
        "heroAlt",
        "canonicalUrl",
        "publishedAt",
        "status",
        "draft"
      ],
      "additionalProperties": false
    },
    "mdx": {
      "type": "string",
      "minLength": 1
    },
    "plainTextSummary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2000
    },
    "headingOutline": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "level",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "claimReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^draftclaim_[a-f0-9]{24}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "claimType": {
            "type": "string",
            "enum": [
              "fact",
              "specification",
              "timeline",
              "quote",
              "interpretation",
              "prediction",
              "opinion",
              "community_observation"
            ]
          },
          "researchClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^claim_[a-f0-9]{24}$"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^source_[a-f0-9]{24}$"
            }
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "supportStatus": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "analysis",
              "opinion",
              "prediction"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "id",
          "statement",
          "claimType",
          "researchClaimIds",
          "sourceIds",
          "section",
          "supportStatus",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "sourceIdsUsed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^source_[a-f0-9]{24}$"
      }
    },
    "declaredAnalysisSections": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "declaredOpinionSections": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "heroImageBrief": {
      "type": "object",
      "properties": {
        "editorialPurpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "mood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "aspectRatio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "official_press_imagery",
            "abstract_editorial",
            "diagram",
            "no_image"
          ]
        },
        "mustNotDepict": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "altTextDraft": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "misinformationRisk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "editorialPurpose",
        "subject",
        "composition",
        "mood",
        "background",
        "aspectRatio",
        "recommendation",
        "mustNotDepict",
        "altTextDraft",
        "misinformationRisk"
      ],
      "additionalProperties": false
    },
    "suggestedSeoMetadata": {
      "type": "object",
      "properties": {
        "keywords": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "searchIntent": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "keywords",
        "searchIntent"
      ],
      "additionalProperties": false
    },
    "writerNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "required": [
    "schemaVersion",
    "topicId",
    "researchPacketId",
    "researchPacketVersion",
    "articleType",
    "metadata",
    "mdx",
    "plainTextSummary",
    "headingOutline",
    "claimReferences",
    "sourceIdsUsed",
    "declaredAnalysisSections",
    "declaredOpinionSections",
    "limitations",
    "heroImageBrief",
    "suggestedSeoMetadata",
    "writerNotes",
    "unresolvedQuestions"
  ],
  "additionalProperties": false
}
