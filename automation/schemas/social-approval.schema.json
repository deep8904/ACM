{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^socialapproval_[a-f0-9]{24}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^socialpackage_[a-f0-9]{24}$"
    },
    "packageVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "platformItemId": {
      "type": "string",
      "pattern": "^socialitem_[a-f0-9]{24}$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "x",
        "instagram",
        "medium"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "approve",
        "schedule",
        "request_changes",
        "reject",
        "hold",
        "mark_posted"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "scheduled",
        "changes_requested",
        "rejected",
        "held",
        "posted_manually",
        "posted"
      ]
    },
    "approvalNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "requestedChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "telegramUpdateId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "telegramMessageId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "callbackQueryId": {
      "type": "string",
      "maxLength": 256
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "packageId",
    "packageVersion",
    "platformItemId",
    "platform",
    "action",
    "status",
    "approvalNotes",
    "requestedChanges",
    "createdAt",
    "updatedAt",
    "telegramUpdateId",
    "version"
  ],
  "additionalProperties": false
}
