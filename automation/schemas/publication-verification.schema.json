{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "publicationId": {
      "type": "string",
      "pattern": "^publication_[a-f0-9]{24}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "failed"
      ]
    },
    "urlLoads": {
      "type": "boolean"
    },
    "correctTitle": {
      "type": "boolean"
    },
    "correctContent": {
      "type": "boolean"
    },
    "correctCanonicalUrl": {
      "type": "boolean"
    },
    "formattingOk": {
      "type": "boolean"
    },
    "sourcesRender": {
      "type": "boolean"
    },
    "noDraftBadge": {
      "type": "boolean"
    },
    "mobileReadable": {
      "type": "boolean"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "verifier": {
      "type": "string",
      "enum": [
        "fixture",
        "manual",
        "http"
      ]
    },
    "importHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "publicationId",
    "status",
    "urlLoads",
    "correctTitle",
    "correctContent",
    "correctCanonicalUrl",
    "formattingOk",
    "sourcesRender",
    "noDraftBadge",
    "mobileReadable",
    "verifiedAt",
    "verifier",
    "notes"
  ],
  "additionalProperties": false
}
