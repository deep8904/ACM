# Milestone 0 runtime configuration
NODE_ENV=development
LOG_LEVEL=info
AI_MODE=assisted

# Unattended structured AI. Obtain this key once from Google AI Studio.
LLM_PROVIDER=gemini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash

# Milestone 3 Telegram topic approval. Keep all values server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_PREVIOUS=
TELEGRAM_CALLBACK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_STATE_DIRECTORY=data/telegram
TELEGRAM_RUNS_DIRECTORY=data/runs
TELEGRAM_CONVERSATION_TTL_MINUTES=30
TELEGRAM_TOPIC_EXPIRY_HOURS=168
TELEGRAM_RECOMMENDATION_BATCH_SIZE=3
TELEGRAM_MAX_SOURCE_PREVIEW=5
TELEGRAM_DEV_ALLOW_UNAUTHORIZED=false

# Milestone 4 local/private research state. No model API is invoked.
RESEARCH_CONFIG=automation/config/research.example.yaml
RESEARCH_STATE_DIRECTORY=data/research
RESEARCH_TASK_DIRECTORY=data/tasks/research

# Milestone 5 local/private writing state. Claude Code is the manual bridge.
WRITING_CONFIG=automation/config/writing.example.yaml
WRITING_STATE_DIRECTORY=data/writing
WRITING_TASK_DIRECTORY=data/tasks/writing

# Milestone 6 private editorial-review and final-approval state.
REVIEW_CONFIG=automation/config/review.example.yaml
REVIEW_STATE_DIRECTORY=data/review
REVIEW_TASK_DIRECTORY=data/tasks/review
REVISION_TASK_DIRECTORY=data/tasks/revision
FINAL_APPROVAL_STATE_DIRECTORY=data/final-approval
ARTICLE_EVENT_DIRECTORY=data/events/article-final-approved

# Milestone 7 publication. Production additionally requires explicit durable state.
PUBLICATION_CONFIG=automation/config/publication.example.yaml
PUBLICATION_STATE_DIRECTORY=data/publication
PUBLICATION_TASK_DIRECTORY=data/tasks/publication
BLOG_FIXTURE_ROOT=data/fixture-blog
# Private server-side durable storage. Never use NEXT_PUBLIC_* for these values.
STORAGE_BACKEND=file
DATABASE_URL=<server-side pooled Postgres URL>
DATABASE_DIRECT_URL=<server-side direct Postgres URL>
DATABASE_SCHEMA=content_machine
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
# Required verbatim before tests may mutate a remote disposable Postgres database.
CONFIRM_DISPOSABLE_TEST_DATABASE=
BLOG_GITHUB_TOKEN=
BLOG_REPOSITORY=
BLOG_DEFAULT_BRANCH=main
BLOG_CONTENT_ROOT=content/blog
SITE_ORIGIN=https://example.com
BLOG_ROUTE_PREFIX=/blog
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Prefer GitHub deployment metadata to avoid a separate Vercel API token.
VERCEL_DEPLOYMENT_METADATA_SOURCE=github

# Stable hosted control plane and worker authorization.
CONTROL_PLANE_ORIGIN=https://your-control-plane.vercel.app
CRON_SECRET=
AUTOMATION_LEASE_MINUTES=30
AUTOMATION_MAX_JOBS_PER_RUN=4

# Milestone 8 private social packaging state. Live posting is disabled.
SOCIAL_CONFIG=automation/config/social.example.yaml
SOCIAL_STATE_DIRECTORY=data/social
SOCIAL_TASK_DIRECTORY=data/tasks/social
SOCIAL_REVISION_TASK_DIRECTORY=data/tasks/social-revision

# Milestone 9 aggregate-only analytics. Live provider access is optional.
ANALYTICS_CONFIG=automation/config/analytics.example.yaml
ANALYTICS_STATE_DIRECTORY=data/analytics
ANALYTICS_TASK_DIRECTORY=data/tasks/analytics
GSC_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
